<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in · ConsultEase</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .login-shell {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
      max-width: 920px;
      border-radius: var(--radius-xl);
      overflow: hidden;
      box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .65);
      animation: fadeUp .5s ease both;
    }
    @media (min-width: 768px) {
      .login-shell { grid-template-columns: 1.05fr 1fr; }
    }
    .login-aside {
      background:
        radial-gradient(600px 400px at 20% 10%, rgba(90, 155, 243, .35), transparent 60%),
        linear-gradient(150deg, var(--navy-950), var(--navy-900) 60%, var(--navy-800));
      color: #fff;
      padding: 2.5rem 2.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 2rem;
    }
    .login-aside h1 {
      font-size: 1.75rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.2;
    }
    .login-aside p { color: rgba(255, 255, 255, .72); font-size: .95rem; }
    .feature-item {
      display: flex;
      align-items: center;
      gap: .75rem;
      font-size: .9rem;
      color: rgba(255, 255, 255, .88);
      padding: .4rem 0;
    }
    .feature-item i {
      width: 34px; height: 34px; border-radius: 10px;
      background: rgba(255, 255, 255, .12);
      display: inline-grid; place-items: center;
      color: var(--accent-300); flex-shrink: 0;
    }
    .login-form-pane { background: #fff; padding: 2.5rem 2.25rem; }
    @media (min-width: 768px) { .login-form-pane { padding: 2.75rem 2.5rem; } }
    .demo-chip {
      width: 100%;
      display: flex;
      align-items: center;
      gap: .75rem;
      border: 1px solid var(--slate-200);
      background: var(--slate-50);
      border-radius: .8rem;
      padding: .6rem .8rem;
      font-size: .82rem;
      transition: all .18s ease;
      text-align: left;
    }
    .demo-chip:hover {
      border-color: var(--accent-500);
      background: rgba(47, 128, 237, .06);
      transform: translateY(-2px);
      box-shadow: var(--shadow-2);
    }
    .demo-chip i {
      width: 32px; height: 32px; border-radius: 9px;
      display: inline-grid; place-items: center; font-size: .95rem; flex-shrink: 0;
    }
    .demo-chip .chip-student i { background: rgba(47, 128, 237, .14); color: var(--accent-500); }
    .demo-chip .chip-faculty i { background: rgba(124, 58, 237, .14); color: #7c3aed; }
    .demo-chip .chip-user { font-family: ui-monospace, 'SF Mono', Menlo, monospace; color: var(--navy-900); font-weight: 600; }
    .demo-chip .chip-pass { color: var(--slate-500); margin-left: auto; }
  </style>
</head>
<body class="auth-body">
  <div class="login-shell">
    <!-- Branding panel -->
    <aside class="login-aside">
      <div>
        <div class="d-flex align-items-center gap-2 mb-4">
          <span class="brand-mark"><i class="bi bi-calendar2-check-fill"></i></span>
          <span class="brand-text">Consult<span class="brand-accent">Ease</span></span>
        </div>
        <h1>Book faculty consultations without the back-and-forth.</h1>
        <p class="mt-3 mb-0">A single place for students to request sessions and faculty to approve them.</p>
      </div>
      <div>
        <div class="feature-item"><i class="bi bi-lightning-charge"></i>Instant booking requests with live status</div>
        <div class="feature-item"><i class="bi bi-shield-check"></i>Role-based access for students &amp; faculty</div>
        <div class="feature-item"><i class="bi bi-calendar-week"></i>Structured slots within consultation hours</div>
      </div>
      <small style="color: rgba(255,255,255,.5);">© <%= new Date().getFullYear() %> ConsultEase</small>
    </aside>

    <!-- Form panel -->
    <main class="login-form-pane">
      <h2 class="h4 fw-bold text-navy mb-1">Welcome back</h2>
      <p class="text-muted small mb-4">Sign in to your account to continue.</p>

      <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger d-flex align-items-start gap-2 py-2 px-3" role="alert">
          <i class="bi bi-exclamation-circle-fill mt-1"></i>
          <div>
            <% errors.forEach(function(error) { %>
              <div class="small"><%= error.msg %></div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" data-live-validate novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <div class="input-icon-wrap">
            <i class="bi bi-person field-icon"></i>
            <div class="form-floating">
              <input type="text" class="form-control" id="username" name="username" placeholder="Username" autocomplete="username" value="<%= formData.username || '' %>" required>
              <label for="username">Username</label>
            </div>
            <div class="invalid-feedback">Please enter your username.</div>
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label">Password</label>
          <div class="input-icon-wrap">
            <i class="bi bi-lock field-icon"></i>
            <div class="form-floating">
              <input type="password" class="form-control" id="password" name="password" placeholder="Password" autocomplete="current-password" required>
              <label for="password">Password</label>
            </div>
            <div class="invalid-feedback">Please enter your password.</div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2">
          Sign in <i class="bi bi-arrow-right ms-1"></i>
        </button>
      </form>

      <div class="mt-4">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="auth-demo-title mb-0">Quick demo login</span>
          <hr class="flex-grow-1 opacity-25">
        </div>
        <div class="d-flex flex-column gap-2">
          <button type="button" class="demo-chip" data-fill-username="student1" data-fill-password="password123">
            <span class="chip-student"><i class="bi bi-mortarboard-fill"></i></span>
            <span>
              <span class="chip-user">student1</span>
              <span class="d-block text-muted" style="font-size:.72rem;">Student account</span>
            </span>
            <span class="chip-pass">password123</span>
          </button>
          <button type="button" class="demo-chip" data-fill-username="faculty1" data-fill-password="password123">
            <span class="chip-faculty"><i class="bi bi-person-workspace"></i></span>
            <span>
              <span class="chip-user">faculty1</span>
              <span class="d-block text-muted" style="font-size:.72rem;">Faculty account</span>
            </span>
            <span class="chip-pass">password123</span>
          </button>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
