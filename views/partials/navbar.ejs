<nav class="navbar navbar-expand-lg app-navbar sticky-top">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2 me-4" href="/">
      <span class="brand-mark"><i class="bi bi-calendar2-check-fill"></i></span>
      <span class="brand-text">Consult<span class="brand-accent">Ease</span></span>
    </a>
    <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <i class="bi bi-list fs-3"></i>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto">
        <% if (user.role === 'student') { %>
          <li class="nav-item">
            <a class="nav-link <%= active === 'dashboard' ? 'active' : '' %>" href="/student/dashboard" <%= active === 'dashboard' ? 'aria-current="page"' : '' %>>
              <i class="bi bi-grid-1x2"></i>Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= active === 'book' ? 'active' : '' %>" href="/student/book" <%= active === 'book' ? 'aria-current="page"' : '' %>>
              <i class="bi bi-calendar-plus"></i>Book Consultation
            </a>
          </li>
        <% } else if (user.role === 'faculty') { %>
          <li class="nav-item">
            <a class="nav-link <%= active === 'dashboard' ? 'active' : '' %>" href="/faculty/dashboard" <%= active === 'dashboard' ? 'aria-current="page"' : '' %>>
              <i class="bi bi-clipboard2-check"></i>Requests
            </a>
          </li>
        <% } %>
      </ul>

      <div class="d-flex align-items-center gap-3">
        <span class="navbar-user d-none d-lg-flex flex-column align-items-end lh-sm">
          <span class="fw-semibold"><%= user.name %></span>
          <span class="role-chip role-<%= user.role %>"><%= user.role %></span>
        </span>
        <div class="dropdown">
          <a class="avatar-btn" href="#" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
            <span class="avatar"><%= user.name.split(' ').map(p => p[0]).join('').substring(0, 2).toUpperCase() %></span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end profile-menu">
            <li>
              <div class="px-3 py-2">
                <div class="fw-bold text-navy"><%= user.name %></div>
                <div class="small text-muted">@<%= user.username %></div>
                <span class="role-chip role-<%= user.role %> mt-1"><%= user.role %></span>
              </div>
            </li>
            <li><hr class="dropdown-divider mx-2"></li>
            <li>
              <a class="dropdown-item" href="/auth/logout">
                <i class="bi bi-box-arrow-right me-2"></i>Sign out
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</nav>
