<%- include('../partials/head', { title: 'Dashboard' }) %>
<%- include('../partials/navbar', { user: user, active: 'dashboard' }) %>

<main class="app-main py-4">
  <div class="container content-fade">
    <div class="page-header">
      <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Signed in as <%= user.name %>.</p>
      </div>
    </div>

    <div class="card app-card">
      <div class="card-body p-4 p-md-5">
        <div class="d-flex align-items-center gap-3 mb-3">
          <span class="stat-icon stat-icon--accent"><i class="bi bi-person-badge"></i></span>
          <div>
            <div class="fw-bold text-navy"><%= user.name %></div>
            <div class="text-muted small">@<%= user.username %> · <span class="role-chip role-<%= user.role %>"><%= user.role %></span></div>
          </div>
        </div>
        <p class="text-muted mb-0">
          Your account doesn't have an assigned dashboard yet. Modules for this role are coming soon.
        </p>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
