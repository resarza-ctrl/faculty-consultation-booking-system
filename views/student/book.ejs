<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Book Consultation - Faculty Consultation Booking System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="/">Faculty Consultation Booking</a>
      <div class="ms-auto">
        <span class="navbar-text me-3">Welcome, <%= user.name %> (<%= user.role %>)</span>
        <a href="/auth/logout" class="btn btn-outline-light btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="row mb-3">
      <div class="col-12">
        <a href="/student/dashboard" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
        </a>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card shadow">
          <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-calendar-plus me-2"></i>Book Consultation</h4>
          </div>
          <div class="card-body">
            <% if (errors && errors.length > 0) { %>
              <div class="alert alert-danger">
                <strong>Please fix the following errors:</strong>
                <ul class="mb-0 mt-2">
                  <% errors.forEach(function(error) { %>
                    <li><%= error.msg %></li>
                  <% }); %>
                </ul>
              </div>
            <% } %>

            <form action="/student/book" method="POST" novalidate>
              <div class="mb-3">
                <label for="facultyId" class="form-label">Select Faculty Member <span class="text-danger">*</span></label>
                <select class="form-select" id="facultyId" name="facultyId" required>
                  <option value="">Choose faculty member...</option>
                  <% facultyList.forEach(function(faculty) { %>
                    <option value="<%= faculty.id %>" 
                      <%= (formData.facultyId == faculty.id) ? 'selected' : '' %>>
                      <%= faculty.name %> - <%= faculty.department %>
                    </option>
                  <% }); %>
                </select>
              </div>

              <div class="row">
                <div class="col-md-6">
                  <div class="mb-3">
                    <label for="date" class="form-label">Consultation Date <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" id="date" name="date" 
                      value="<%= formData.date || '' %>" required>
                    <small class="text-muted">Select a future date</small>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="mb-3">
                    <label for="time" class="form-label">Time Slot <span class="text-danger">*</span></label>
                    <input type="time" class="form-control" id="time" name="time" 
                      min="09:00" max="17:00" value="<%= formData.time || '' %>" required>
                    <small class="text-muted">Consultation hours: 9:00 AM - 5:00 PM</small>
                  </div>
                </div>
              </div>

              <div class="mb-3">
                <label for="subject" class="form-label">Reason/Subject <span class="text-danger">*</span></label>
                <textarea class="form-control" id="subject" name="subject" rows="4" 
                  placeholder="Enter reason for consultation (e.g., Assignment discussion, Project guidance, etc.)" 
                  required><%= formData.subject || '' %></textarea>
                <small class="text-muted">5-500 characters</small>
              </div>

              <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a href="/student/dashboard" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-bookmark-check me-2"></i>Confirm Booking
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Set minimum date to today
    document.addEventListener('DOMContentLoaded', function() {
      const dateInput = document.getElementById('date');
      const today = new Date();
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      dateInput.min = yyyy + '-' + mm + '-' + dd;
    });
  </script>
</body>
</html>
