<%- include('../partials/head', { title: 'Book a Consultation' }) %>
<%- include('../partials/navbar', { user: user, active: 'book' }) %>

<main class="app-main py-4">
  <div class="container content-fade">

    <div class="page-header">
      <div>
        <h1 class="page-title">Book a Consultation</h1>
        <p class="page-subtitle">Request a session with a faculty member. You'll get a confirmation once it's approved.</p>
      </div>
      <a href="/student/dashboard" class="btn btn-ghost">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
      </a>
    </div>

    <div class="row g-4">
      <!-- Form column -->
      <div class="col-lg-8">
        <div class="card app-card">
          <div class="card-body p-4 p-md-5">

            <% if (errors && errors.length > 0) { %>
              <div class="alert alert-danger d-flex align-items-start gap-2 py-2 px-3" role="alert">
                <i class="bi bi-exclamation-circle-fill mt-1"></i>
                <div>
                  <div class="fw-semibold small mb-1">Please fix the following:</div>
                  <ul class="mb-0 ps-3 small">
                    <% errors.forEach(function(error) { %>
                      <li><%= error.msg %></li>
                    <% }); %>
                  </ul>
                </div>
              </div>
            <% } %>

            <form action="/student/book" method="POST" data-live-validate novalidate>

              <!-- Section 1: Faculty -->
              <div class="form-section">
                <div class="form-section-title">
                  <span class="step-dot">1</span>
                  <i class="bi bi-person-badge"></i>Choose Faculty Member
                </div>
                <label for="facultyId" class="form-label visually-hidden">Faculty member</label>
                <div class="input-icon-wrap">
                  <i class="bi bi-person field-icon"></i>
                  <select class="form-select" id="facultyId" name="facultyId" required>
                    <option value="" disabled <%= !formData.facultyId ? 'selected' : '' %>>Select a faculty member…</option>
                    <% facultyList.forEach(function(faculty) { %>
                      <option value="<%= faculty.id %>" <%= (formData.facultyId == faculty.id) ? 'selected' : '' %>>
                        <%= faculty.name %> — <%= faculty.department %>
                      </option>
                    <% }); %>
                  </select>
                  <div class="invalid-feedback">Please select a faculty member.</div>
                </div>
                <div class="field-hint"><i class="bi bi-info-circle"></i>Consultation hours run 9:00 AM – 5:00 PM, weekdays.</div>
              </div>

              <!-- Section 2: Schedule -->
              <div class="form-section">
                <div class="form-section-title">
                  <span class="step-dot">2</span>
                  <i class="bi bi-calendar2-week"></i>Pick a Date &amp; Time Slot
                </div>
                <div class="row g-3">
                  <div class="col-md-6">
                    <label for="date" class="form-label">Date</label>
                    <div class="input-icon-wrap">
                      <i class="bi bi-calendar3 field-icon"></i>
                      <div class="form-floating">
                        <input type="date" class="form-control" id="date" name="date" value="<%= formData.date || '' %>" required>
                        <label for="date">Consultation date</label>
                      </div>
                      <div class="invalid-feedback">Choose a valid future date.</div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <label for="time" class="form-label">Time slot</label>
                    <div class="input-icon-wrap">
                      <i class="bi bi-clock field-icon"></i>
                      <div class="form-floating">
                        <input type="time" class="form-control" id="time" name="time" min="09:00" max="17:00" step="1800" value="<%= formData.time || '' %>" required>
                        <label for="time">Start time</label>
                      </div>
                      <div class="invalid-feedback">Pick a slot between 9:00 AM and 5:00 PM.</div>
                    </div>
                    <div class="field-hint"><i class="bi bi-clock-history"></i>30-minute steps within office hours</div>
                  </div>
                </div>
              </div>

              <!-- Section 3: Reason -->
              <div class="form-section">
                <div class="form-section-title">
                  <span class="step-dot">3</span>
                  <i class="bi bi-chat-left-text"></i>Reason for Consultation
                </div>
                <label for="subject" class="form-label">Topic / Subject</label>
                <textarea class="form-control" id="subject" name="subject" rows="4" maxlength="500"
                  data-maxlength="500" required
                  placeholder="e.g. Clarify week 6 assignment requirements, discuss project scope…"><%= formData.subject || '' %></textarea>
                <div class="invalid-feedback">Please provide a reason (at least 5 characters).</div>
                <div class="field-hint d-none" id="subject-count"></div>
              </div>

              <!-- Actions -->
              <div class="d-flex flex-column flex-sm-row gap-2 justify-content-sm-end mt-4">
                <a href="/student/dashboard" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-accent px-4">
                  <i class="bi bi-send me-1"></i>Submit Booking Request
                </button>
              </div>

            </form>
          </div>
        </div>
      </div>

      <!-- Aside: info panel -->
      <div class="col-lg-4">
        <div class="card app-card">
          <div class="card-body p-4">
            <span class="section-title mb-3 d-block"><i class="bi bi-signpost-split"></i>How it works</span>
            <div class="d-flex gap-3 mb-3">
              <span class="stat-icon stat-icon--accent"><i class="bi bi-pencil-square"></i></span>
              <div>
                <div class="fw-bold text-navy small">1. Submit a request</div>
                <div class="text-muted" style="font-size:.84rem;">Pick a faculty member, slot, and topic.</div>
              </div>
            </div>
            <div class="d-flex gap-3 mb-3">
              <span class="stat-icon stat-icon--amber"><i class="bi bi-hourglass-split"></i></span>
              <div>
                <div class="fw-bold text-navy small">2. Awaiting approval</div>
                <div class="text-muted" style="font-size:.84rem;">Your request stays <span class="badge badge-pending">Pending</span> until reviewed.</div>
              </div>
            </div>
            <div class="d-flex gap-3">
              <span class="stat-icon stat-icon--green"><i class="bi bi-check2-circle"></i></span>
              <div>
                <div class="fw-bold text-navy small">3. Get confirmed</div>
                <div class="text-muted" style="font-size:.84rem;">Approved sessions appear on your dashboard.</div>
              </div>
            </div>
            <hr>
            <div class="d-flex align-items-center gap-2 small text-muted">
              <i class="bi bi-shield-check text-navy"></i>
              Only your own bookings are visible to you.
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
