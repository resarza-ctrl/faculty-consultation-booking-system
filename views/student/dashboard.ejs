<%- include('../partials/head', { title: 'Student Dashboard' }) %>
<%- include('../partials/navbar', { user: user, active: 'dashboard' }) %>

<%
  var totalBookings = (typeof upcomingBookings !== 'undefined' ? upcomingBookings.length : 0) +
                      (typeof pastBookings !== 'undefined' ? pastBookings.length : 0);
  var approvedCount = (typeof upcomingBookings !== 'undefined' ? upcomingBookings : [])
    .concat(typeof pastBookings !== 'undefined' ? pastBookings : [])
    .filter(function (b) { return b.status === 'Approved'; }).length;
  var pendingCount = (typeof upcomingBookings !== 'undefined' ? upcomingBookings : [])
    .filter(function (b) { return b.status === 'Pending'; }).length;
%>

<%- include('../partials/toast', { success: typeof success !== 'undefined' ? success : null }) %>

<main class="app-main py-4">
  <div class="container content-fade">

    <!-- Page header -->
    <div class="page-header">
      <div>
        <h1 class="page-title">Welcome back, <%= user.name.split(' ')[0] %> 👋</h1>
        <p class="page-subtitle">Here's an overview of your consultation bookings.</p>
      </div>
      <a href="/student/book" class="btn btn-accent">
        <i class="bi bi-plus-lg me-1"></i>Book New Consultation
      </a>
    </div>

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-head">
            <span class="stat-icon stat-icon--navy"><i class="bi bi-journal-check"></i></span>
          </div>
          <div class="stat-value"><%= totalBookings %></div>
          <div class="stat-label">Total Bookings</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-head">
            <span class="stat-icon stat-icon--accent"><i class="bi bi-calendar-event"></i></span>
          </div>
          <div class="stat-value"><%= upcomingBookings ? upcomingBookings.length : 0 %></div>
          <div class="stat-label">Upcoming</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-head">
            <span class="stat-icon stat-icon--amber"><i class="bi bi-hourglass-split"></i></span>
          </div>
          <div class="stat-value"><%= pendingCount %></div>
          <div class="stat-label">Awaiting Reply</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-head">
            <span class="stat-icon stat-icon--green"><i class="bi bi-check2-circle"></i></span>
          </div>
          <div class="stat-value"><%= approvedCount %></div>
          <div class="stat-label">Approved</div>
        </div>
      </div>
    </div>

    <!-- Upcoming bookings -->
    <div class="card app-card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span class="section-title"><i class="bi bi-calendar-event"></i>Upcoming Bookings</span>
        <span class="count-chip"><%= upcomingBookings ? upcomingBookings.length : 0 %></span>
      </div>
      <div class="card-body p-0">
        <% if (upcomingBookings && upcomingBookings.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-modern align-middle">
              <thead>
                <tr>
                  <th>Date &amp; Time</th>
                  <th>Faculty</th>
                  <th>Department</th>
                  <th>Reason / Subject</th>
                  <th class="text-end">Status</th>
                </tr>
              </thead>
              <tbody>
                <% upcomingBookings.forEach(function(booking) { %>
                  <tr>
                    <td>
                      <div class="cell-primary"><%= booking.date %></div>
                      <span class="cell-sub"><i class="bi bi-clock"></i><%= booking.time %></span>
                    </td>
                    <td><%= booking.facultyName %></td>
                    <td><span class="badge badge-neutral"><%= booking.facultyDept %></span></td>
                    <td><%= booking.subject %></td>
                    <td class="text-end">
                      <% if (booking.status === 'Approved') { %>
                        <span class="badge badge-approved"><i class="bi bi-check-circle me-1"></i>Approved</span>
                      <% } else if (booking.status === 'Rejected') { %>
                        <span class="badge badge-rejected"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                      <% } else { %>
                        <span class="badge badge-pending"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <span class="empty-icon"><i class="bi bi-calendar-x"></i></span>
            <p class="mb-2 fw-semibold text-navy">No upcoming bookings</p>
            <p class="small mb-3">Schedule a session with a faculty member to get started.</p>
            <a href="/student/book" class="btn btn-accent btn-sm"><i class="bi bi-plus-lg me-1"></i>Book a consultation</a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Past bookings -->
    <div class="card app-card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span class="section-title"><i class="bi bi-clock-history"></i>Past Bookings</span>
        <span class="count-chip"><%= pastBookings ? pastBookings.length : 0 %></span>
      </div>
      <div class="card-body p-0">
        <% if (pastBookings && pastBookings.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-modern align-middle">
              <thead>
                <tr>
                  <th>Date &amp; Time</th>
                  <th>Faculty</th>
                  <th>Department</th>
                  <th>Reason / Subject</th>
                  <th class="text-end">Status</th>
                </tr>
              </thead>
              <tbody>
                <% pastBookings.forEach(function(booking) { %>
                  <tr>
                    <td>
                      <div class="cell-primary"><%= booking.date %></div>
                      <span class="cell-sub"><i class="bi bi-clock"></i><%= booking.time %></span>
                    </td>
                    <td><%= booking.facultyName %></td>
                    <td><span class="badge badge-neutral"><%= booking.facultyDept %></span></td>
                    <td><%= booking.subject %></td>
                    <td class="text-end">
                      <% if (booking.status === 'Approved') { %>
                        <span class="badge badge-approved"><i class="bi bi-check-circle me-1"></i>Approved</span>
                      <% } else if (booking.status === 'Rejected') { %>
                        <span class="badge badge-rejected"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                      <% } else { %>
                        <span class="badge badge-neutral"><%= booking.status %></span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <span class="empty-icon"><i class="bi bi-journal-text"></i></span>
            <p class="mb-0">No past consultations yet.</p>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
