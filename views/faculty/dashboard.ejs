<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Faculty Dashboard - Faculty Consultation Booking System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="/">Faculty Consultation Booking</a>
      <div class="ms-auto">
        <span class="navbar-text me-3">Welcome, <%= user.name %> (<%= user.role %>)</span>
        <a href="/auth/logout" class="btn btn-outline-light btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i><%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="row mb-4">
      <div class="col-12">
        <h3>Faculty Dashboard</h3>
        <p class="text-muted">Manage consultation booking requests</p>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <div class="card shadow">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>Booking Requests</h5>
          </div>
          <div class="card-body">
            <% if (bookings && bookings.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead>
                    <tr>
                      <th>Date & Time</th>
                      <th>Student</th>
                      <th>Subject/Reason</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% bookings.forEach(function(booking) { %>
                      <tr>
                        <td><strong><%= booking.date %></strong> at <%= booking.time %></td>
                        <td><%= booking.studentName %></td>
                        <td><%= booking.subject %></td>
                        <td>
                          <% if (booking.status === 'Pending') { %>
                            <span class="badge bg-warning text-dark"><%= booking.status %></span>
                          <% } else if (booking.status === 'Approved') { %>
                            <span class="badge bg-success"><%= booking.status %></span>
                          <% } else if (booking.status === 'Rejected') { %>
                            <span class="badge bg-danger"><%= booking.status %></span>
                          <% } else { %>
                            <span class="badge bg-secondary"><%= booking.status %></span>
                          <% } %>
                        </td>
                        <td>
                          <% if (booking.status === 'Pending') { %>
                            <div class="d-flex gap-2">
                              <form action="/faculty/booking/<%= booking.id %>/approve" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success" 
                                  onclick="return confirm('Approve this booking request?')">
                                  <i class="bi bi-check-circle me-1"></i>Approve
                                </button>
                              </form>
                              <form action="/faculty/booking/<%= booking.id %>/reject" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger"
                                  onclick="return confirm('Reject this booking request?')">
                                  <i class="bi bi-x-circle me-1"></i>Reject
                                </button>
                              </form>
                            </div>
                          <% } else { %>
                            <span class="text-muted small">No actions available</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <p class="text-muted mb-0">No booking requests yet.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
