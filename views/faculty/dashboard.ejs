<%- include('../partials/head', { title: 'Faculty Dashboard' }) %>
<%- include('../partials/navbar', { user: user, active: 'dashboard' }) %>

<%
  var list = (typeof bookings !== 'undefined' && bookings) ? bookings : [];
  var pendingList = list.filter(function (b) { return b.status === 'Pending'; });
  var approvedList = list.filter(function (b) { return b.status === 'Approved'; });
  var rejectedList = list.filter(function (b) { return b.status === 'Rejected'; });
%>

<%- include('../partials/toast', { success: typeof success !== 'undefined' ? success : null, error: typeof error !== 'undefined' ? error : null }) %>

<main class="app-main py-4">
  <div class="container content-fade">

    <!-- Page header -->
    <div class="page-header">
      <div>
        <h1 class="page-title">Consultation Requests</h1>
        <p class="page-subtitle">Review, approve, or decline booking requests from students.</p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge badge-pending py-2 px-3"><i class="bi bi-hourglass-split me-1"></i><%= pendingList.length %> awaiting review</span>
      </div>
    </div>

    <!-- Summary stat cards -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-head">
            <span class="stat-icon stat-icon--navy"><i class="bi bi-inbox"></i></span>
          </div>
          <div class="stat-value"><%= list.length %></div>
          <div class="stat-label">Total Requests</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-head">
            <span class="stat-icon stat-icon--amber"><i class="bi bi-hourglass-split"></i></span>
          </div>
          <div class="stat-value"><%= pendingList.length %></div>
          <div class="stat-label">Pending Approvals</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-head">
            <span class="stat-icon stat-icon--green"><i class="bi bi-check2-circle"></i></span>
          </div>
          <div class="stat-value"><%= approvedList.length %></div>
          <div class="stat-label">Approved Sessions</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-head">
            <span class="stat-icon stat-icon--red"><i class="bi bi-x-circle"></i></span>
          </div>
          <div class="stat-value"><%= rejectedList.length %></div>
          <div class="stat-label">Rejected</div>
        </div>
      </div>
    </div>

    <!-- Requests table -->
    <div class="card app-card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span class="section-title"><i class="bi bi-clipboard2-check"></i>Booking Requests</span>
        <span class="count-chip"><%= list.length %> total</span>
      </div>
      <div class="card-body p-0">
        <% if (list.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-modern align-middle">
              <thead>
                <tr>
                  <th>Date &amp; Time</th>
                  <th>Student</th>
                  <th>Reason / Subject</th>
                  <th>Status</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% list.forEach(function(booking) { %>
                  <tr>
                    <td>
                      <div class="cell-primary"><%= booking.date %></div>
                      <span class="cell-sub"><i class="bi bi-clock"></i><%= booking.time %></span>
                    </td>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <span class="avatar" style="width:32px;height:32px;font-size:.7rem;border:none;">
                          <%= booking.studentName.split(' ').map(function(p){ return p[0]; }).join('').substring(0, 2).toUpperCase() %>
                        </span>
                        <span class="cell-primary"><%= booking.studentName %></span>
                      </div>
                    </td>
                    <td><%= booking.subject %></td>
                    <td>
                      <% if (booking.status === 'Approved') { %>
                        <span class="badge badge-approved"><i class="bi bi-check-circle me-1"></i>Approved</span>
                      <% } else if (booking.status === 'Rejected') { %>
                        <span class="badge badge-rejected"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                      <% } else { %>
                        <span class="badge badge-pending"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                      <% } %>
                    </td>
                    <td class="text-end">
                      <% if (booking.status === 'Pending') { %>
                        <div class="d-inline-flex gap-2">
                          <form action="/faculty/booking/<%= booking.id %>/approve" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-approve"
                              onclick="return confirm('Approve this booking request?')">
                              <i class="bi bi-check-lg me-1"></i>Approve
                            </button>
                          </form>
                          <form action="/faculty/booking/<%= booking.id %>/reject" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-reject"
                              onclick="return confirm('Reject this booking request?')">
                              <i class="bi bi-x-lg me-1"></i>Reject
                            </button>
                          </form>
                        </div>
                      <% } else { %>
                        <span class="text-muted" style="font-size:.8rem;">
                          <i class="bi bi-lock me-1"></i>Decided
                        </span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <span class="empty-icon"><i class="bi bi-inbox"></i></span>
            <p class="mb-2 fw-semibold text-navy">No booking requests yet</p>
            <p class="small mb-0">Requests from students will show up here for review.</p>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
